# Copy karo: cp .env.example .env   (.env git me nahi jaata)

# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_password
POSTGRES_DB=calling_crm
POSTGRES_PORT=5433
DATABASE_URL=postgresql://crm:crm_local_password@localhost:5433/calling_crm

# Redis (BullMQ background jobs — follow-up reminders / escalation)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Background scheduler (follow-up tick har 30s). false = band (tests me automatically false)
SCHEDULER_ENABLED=true

# API (NestJS)
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web (Next.js) — backend kahan hai (rewrites /api/* → yahan)
API_URL=http://localhost:4000

# Auth (JWT)
# Production me lamba random secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# Pehla Super Admin (npm run db:seed) — login ke baad password badal dena
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@crm.local
SEED_ADMIN_PASSWORD=ChangeMe@123

# NOTE: Agar aapne POSTGRES_PORT/REDIS_PORT badla hai (default ab 5433/6380 hai, kyunki local 5432/6379 pe pehle se kuch chal raha tha),
# to DATABASE_URL aur REDIS_URL me bhi wahi port likhna.
