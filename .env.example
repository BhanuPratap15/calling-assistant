# Copy karo: cp .env.example .env   (.env git me nahi jaata)

# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_password
POSTGRES_DB=calling_crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:crm_local_password@localhost:5432/calling_crm

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API (NestJS)
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# NOTE: Agar aapne POSTGRES_PORT/REDIS_PORT badla hai (e.g. 5433/6380),
# to DATABASE_URL aur REDIS_URL me bhi wahi port likhna.
