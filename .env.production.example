# =====================================================================
# PRODUCTION config — copy: cp .env.production.example .env.production
# .env.production KABHI commit nahi hota (.gitignore). Secrets lambe + random rakho:
#   openssl rand -hex 32
# Passwords me sirf letters + numbers (URL me jaate hain — @ : / jaise characters se dikkat)
# =====================================================================

# Domain (Nginx + cookie + CORS) — DNS ka A record is server ke IP pe
SERVER_NAME=crm.example.com

# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_long_random_alnum
POSTGRES_DB=calling_crm

# Redis
REDIS_PASSWORD=CHANGE_ME_long_random_alnum

# Login tokens — kam se kam 32 random characters
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# Pehla Super Admin (sirf `docker compose run --rm migrate npx prisma db seed` ke liye)
# Pehle login pe password badalna zaroori hai
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_Temp123

# ---------------- White-label platform (docs/WHITE-LABEL.md) ----------------
# Platform panel (/platform) ka pehla login — `docker compose run --rm migrate npx prisma db seed`
PLATFORM_ADMIN_EMAIL=you@yourcompany.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_Temp123
# Clients ko <slug>.<ye domain> milta hai (wildcard DNS: *.crm.yourcompany.com → server IP). Khaali = sirf custom domains
PLATFORM_BASE_DOMAIN=
# Is server ka public IP (DNS check + panel me client ko dikhane ke liye). Kai ho to comma se
PLATFORM_SERVER_IP=
# Client sub-domains ke liye CNAME target (khaali = app.<PLATFORM_BASE_DOMAIN>)
PLATFORM_CNAME_TARGET=
# ops/platform/sync-domains.sh (cron) ↔ API — openssl rand -hex 32
PLATFORM_SYNC_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Naye client domains ke SSL certificates (Let's Encrypt) ka email
LETSENCRYPT_EMAIL=you@yourcompany.com
# /platform sirf in hosts pe khule (comma). Khaali = har host pe (login phir bhi zaroori)
PLATFORM_HOSTS=
# Jo address kisi client se match na ho → ye client (purana single-client setup). Sab domains
# panel me add ho jaayein to khaali kar do (TENANT_FALLBACK_SLUG=) — anjaan address = "not found"
TENANT_FALLBACK_SLUG=default

# HTTPS certificates folder (fullchain.pem + privkey.pem) — docs/DEPLOYMENT.md (Let's Encrypt)
CERTS_DIR=./ops/certs

# true = cookie sirf HTTPS pe (production me hamesha true)
COOKIE_SECURE=true

# Reports
REPORT_TIMEZONE=Asia/Kolkata

# Rate limit (har IP / minute) — poora office ek IP pe ho to kaafi bada rakho
RATE_LIMIT_PER_MIN=3000

# Calling provider: manual (tel: link) — telecalling.ai adapter aane tak
TELEPHONY_PROVIDER=manual
TELEPHONY_WEBHOOK_SECRET=

# Monitoring (ops/monitoring/check.sh, cron) — Slack / Google Chat / Teams incoming webhook
ALERT_WEBHOOK_URL=

# Backups
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Images (CD pipeline GHCR se pull kare to): ghcr.io/<owner>/calling-crm , tag = git sha
IMAGE_PREFIX=calling-crm
IMAGE_TAG=local
