# =====================================================================
# API manually test karne ki file (VS Code extension: "REST Client")
# Har request ke upar "Send Request" link aata hai — click karo.
# Pehle: npm run dev:api  +  npm run db:seed
# =====================================================================

@baseUrl = http://localhost:4000/api

### 1. Health (public — token nahi chahiye)
GET {{baseUrl}}/health

### 2. Login → response me accessToken milega
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@crm.local",
  "password": "ChangeMe@123"
}

### 3. Me — login (request 2) ka token automatically use hota hai
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.accessToken}}

### 4. Staff list (sirf MANAGER / SUPER_ADMIN)
GET {{baseUrl}}/staff
Authorization: Bearer {{login.response.body.accessToken}}

### 5. Bina token → 401
GET {{baseUrl}}/staff

### 6. Galat body → 400 (validation)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "not-an-email"
}

# ---------------------------------------------------------------------
# Customers (MANAGER create/update; MANAGER + TEAM_LEADER read)
# ---------------------------------------------------------------------

### 7. Customer banao (phone kisi bhi format me — +91 E.164 me save hoga)
# @name createCustomer
POST {{baseUrl}}/customers
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Rahul Sharma",
  "phone": "98765 43210",
  "priority": "HIGH",
  "notes": "Test customer"
}

### 8. Same number dobara (alag format) → 409 Conflict
POST {{baseUrl}}/customers
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Duplicate Rahul",
  "phone": "+91-98765-43210"
}

### 9. List + search + pagination
GET {{baseUrl}}/customers?search=rahul&page=1&pageSize=20
Authorization: Bearer {{login.response.body.accessToken}}

### 10. Ek customer
GET {{baseUrl}}/customers/{{createCustomer.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

### 11. Update (sirf jo badalna hai wahi bhejo)
PATCH {{baseUrl}}/customers/{{createCustomer.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "status": "DO_NOT_CALL"
}

# ---------------------------------------------------------------------
# Staff & Teams (MANAGER; Team Leader sirf apni teams dekh sakta hai)
# ---------------------------------------------------------------------

### 12. Team Leader banao
# @name createLeader
POST {{baseUrl}}/staff
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Priya TL",
  "email": "priya@crm.local",
  "password": "Leader@123",
  "role": "TEAM_LEADER"
}

### 13. Team banao (leader = upar wala TL)
# @name createTeam
POST {{baseUrl}}/teams
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Team Alpha",
  "description": "Casino new users calling team",
  "leaderId": "{{createLeader.response.body.id}}"
}

### 14. Assistant banao, seedha team me
# @name createAssistant
POST {{baseUrl}}/staff
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Amit",
  "email": "amit@crm.local",
  "password": "Assistant@123",
  "role": "ASSISTANT",
  "teamId": "{{createTeam.response.body.id}}"
}

### 15. Team detail (members ke saath)
GET {{baseUrl}}/teams/{{createTeam.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

### 16. Staff list — filter: ?role=ASSISTANT&teamId=...&isActive=true
GET {{baseUrl}}/staff?role=ASSISTANT
Authorization: Bearer {{login.response.body.accessToken}}

### 17. Assistant update (team se hatao: "teamId": null; deactivate: "isActive": false)
PATCH {{baseUrl}}/staff/{{createAssistant.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "phone": "9876543210"
}

### 18. Assistant ka password reset (Manager) → 204
POST {{baseUrl}}/staff/{{createAssistant.response.body.id}}/reset-password
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "newPassword": "NewPass@456"
}

### 19. Apna password badlo (Super Admin: seed wala default password badal do!)
POST {{baseUrl}}/auth/change-password
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "currentPassword": "ChangeMe@123",
  "newPassword": "MyNewStrong@2026"
}

# ---------------------------------------------------------------------
# Audit logs (MANAGER / SUPER_ADMIN — sirf padhne ke liye)
# ---------------------------------------------------------------------

### 20. Sab latest activity (newest first)
GET {{baseUrl}}/audit-logs?page=1&pageSize=20
Authorization: Bearer {{login.response.body.accessToken}}

### 21. Ek customer ki poori history
GET {{baseUrl}}/audit-logs?entityType=customer&entityId={{createCustomer.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

### 22. Failed login attempts
GET {{baseUrl}}/audit-logs?action=auth.login_failed
Authorization: Bearer {{login.response.body.accessToken}}

### 23. Date range (from / to)
GET {{baseUrl}}/audit-logs?from=2026-10-01&to=2026-12-31&entityType=staff
Authorization: Bearer {{login.response.body.accessToken}}

# ---------------------------------------------------------------------
# Call form settings (Step 2.1)
# ---------------------------------------------------------------------

### 24. Call form config (koi bhi logged-in — assistant ka form isse banega)
GET {{baseUrl}}/call-config
Authorization: Bearer {{login.response.body.accessToken}}

### 25. Admin view (inactive options bhi) — MANAGER
GET {{baseUrl}}/call-config/admin
Authorization: Bearer {{login.response.body.accessToken}}

### 26. Naya call outcome — MANAGER
POST {{baseUrl}}/call-config/outcomes
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "code": "CALLBACK_REQUESTED",
  "label": "Callback Requested",
  "isConnected": true,
  "sortOrder": 25
}

### 27. Mandatory fields badlo — rule: "always" | "connected" | "optional"
PUT {{baseUrl}}/call-config/required-fields
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "userResponse": "connected",
  "notes": "always",
  "interestRating": "connected"
}

# ---------------------------------------------------------------------
# Calling workflow (Phase 2) — ASSISTANT / TEAM_LEADER token se chalao
# (Super Admin se bhi chal jaata hai)
# ---------------------------------------------------------------------

### 28. Current customer (null = koi nahi)
GET {{baseUrl}}/calling/current
Authorization: Bearer {{login.response.body.accessToken}}

### 29. Start Calling → ek customer milega
# @name startCalling
POST {{baseUrl}}/calling/next
Authorization: Bearer {{login.response.body.accessToken}}

### 30. Save & Next — outcomeId / nextActionId request 24 (/call-config) se copy karo
POST {{baseUrl}}/calling/complete
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "outcomeId": "PASTE-OUTCOME-ID",
  "nextActionId": "PASTE-NEXT-ACTION-ID",
  "userResponse": "Call me at 4 PM",
  "notes": "Interested in VIP program",
  "interestRating": 9,
  "followUpAt": "2026-12-31T16:00:00+05:30"
}

### 31. Customer 360° profile
GET {{baseUrl}}/customers/{{createCustomer.response.body.id}}/profile
Authorization: Bearer {{login.response.body.accessToken}}

### 32. Manual assign (MANAGER / TEAM_LEADER)
POST {{baseUrl}}/assignments
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "customerId": "{{createCustomer.response.body.id}}",
  "staffId": "{{createAssistant.response.body.id}}"
}

### 33. Open assignments (status: open | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED)
GET {{baseUrl}}/assignments?status=open
Authorization: Bearer {{login.response.body.accessToken}}

### 34. Assign dropdown options (role ke hisaab se)
GET {{baseUrl}}/assignments/assignable-staff
Authorization: Bearer {{login.response.body.accessToken}}

# ---------------------------------------------------------------------
# Follow-ups, availability, notifications (Phase 3)
# ---------------------------------------------------------------------

### 35. Apna status: AVAILABLE | BREAK | OFFLINE  (ON_CALL system set karta hai)
PATCH {{baseUrl}}/auth/availability
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "availability": "BREAK"
}

### 36. Follow-ups — bucket: open | upcoming | due | overdue | completed | cancelled
GET {{baseUrl}}/follow-ups?bucket=open
Authorization: Bearer {{login.response.body.accessToken}}

### 37. Follow-up counts (dashboard cards)
GET {{baseUrl}}/follow-ups/summary
Authorization: Bearer {{login.response.body.accessToken}}

### 38. Reschedule (owner / Manager / TL) — id request 36 se
POST {{baseUrl}}/follow-ups/PASTE-FOLLOW-UP-ID/reschedule
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "dueAt": "2026-12-31T16:00:00+05:30"
}

### 39. Notifications (sirf apni)
GET {{baseUrl}}/notifications
Authorization: Bearer {{login.response.body.accessToken}}

### 40. Unread count (header bell)
GET {{baseUrl}}/notifications/unread-count
Authorization: Bearer {{login.response.body.accessToken}}

### 41. Follow-up timing (MANAGER) — minutes
PUT {{baseUrl}}/call-config/follow-up-timing
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "reminderMinutesBefore": 1,
  "gracePeriodMinutes": 10,
  "presenceTimeoutMinutes": 5
}

# ---------------------------------------------------------------------
# Categories & tags (Phase 4)
# ---------------------------------------------------------------------

### 42. Categories (rating ranges)
GET {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.accessToken}}

### 43. Category-wise customer counts (MANAGER / TL)
GET {{baseUrl}}/categories/summary
Authorization: Bearer {{login.response.body.accessToken}}

### 44. Thresholds save (MANAGER) — poora set; ids request 42 se. Saare customers recalculate hote hain.
PUT {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "categories": [
    { "id": "PASTE-ID", "code": "HIGH_INTEREST", "label": "High Interest", "minRating": 8, "maxRating": 9, "color": "yellow", "priority": "HIGH", "isActive": true, "sortOrder": 30 }
  ]
}

### 45. Tags
GET {{baseUrl}}/tags
Authorization: Bearer {{login.response.body.accessToken}}

### 46. Naya tag (MANAGER)
# @name createTag
POST {{baseUrl}}/tags
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Big Spender",
  "color": "green"
}

### 47. Customer ke tags (poori list replace)
PUT {{baseUrl}}/customers/{{createCustomer.response.body.id}}/tags
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "tagIds": ["{{createTag.response.body.id}}"]
}

### 48. Customers: category / tag filter, highest rating first
GET {{baseUrl}}/customers?sort=rating&categoryId=none
Authorization: Bearer {{login.response.body.accessToken}}

# ============ Campaigns (Phase 5) ============

### 49. Naya campaign (MANAGER) — DRAFT me banta hai
# @name createCampaign
POST {{baseUrl}}/campaigns
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Diwali Bonus",
  "priority": 50,
  "script": "Namaste ji! Is Diwali pe 100% deposit bonus mil raha hai."
}

### 50. Custom fields (poora set; key + type baad me nahi badalte)
PUT {{baseUrl}}/campaigns/{{createCampaign.response.body.id}}/fields
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "fields": [
    { "key": "deposit_amount", "label": "Deposit amount", "type": "NUMBER", "options": [], "required": true, "isActive": true, "sortOrder": 10 },
    { "key": "game", "label": "Preferred game", "type": "SELECT", "options": ["Slots", "Poker"], "required": false, "isActive": true, "sortOrder": 20 }
  ]
}

### 51. Customers add — filter se (sirf fresh leads)
POST {{baseUrl}}/campaigns/{{createCampaign.response.body.id}}/customers
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "filter": { "neverCalled": true }
}

### 52. Kaun call karega (dono khaali = sab)
PUT {{baseUrl}}/campaigns/{{createCampaign.response.body.id}}/members
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "staffIds": [],
  "teamIds": []
}

### 53. Activate (DRAFT → ACTIVE). Pause: "PAUSED", khatam: "COMPLETED"
PATCH {{baseUrl}}/campaigns/{{createCampaign.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "status": "ACTIVE"
}

### 54. Campaign detail + stats
GET {{baseUrl}}/campaigns/{{createCampaign.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

### 55. Campaign customers — pending (abhi call nahi hua)
GET {{baseUrl}}/campaigns/{{createCampaign.response.body.id}}/customers?state=pending
Authorization: Bearer {{login.response.body.accessToken}}

### 56. Save & Next with campaign fields (assistant token chahiye; current.campaign.fields dekh ke)
POST {{baseUrl}}/calling/complete
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "outcomeId": "PASTE-OUTCOME-ID",
  "nextActionId": "PASTE-NEXT-ACTION-ID",
  "customFields": { "deposit_amount": 5000, "game": "Poker" }
}

# ============ Bulk import (Phase 6) ============

### 57. Upload CSV → preview (MANAGER). File: is folder me users.csv bana lo (name,phone,...)
# @name importPreview
POST {{baseUrl}}/imports
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: multipart/form-data; boundary=----crm

------crm
Content-Disposition: form-data; name="file"; filename="users.csv"
Content-Type: text/csv

name,phone,email,priority
Rahul Import,9876500001,rahul@example.com,HIGH
Bad Row,12345,,
------crm--

### 58. Preview ki lines (galat wali)
GET {{baseUrl}}/imports/{{importPreview.response.body.id}}/rows?status=INVALID
Authorization: Bearer {{login.response.body.accessToken}}

### 59. Confirm → background import (campaignId / tagId optional)
POST {{baseUrl}}/imports/{{importPreview.response.body.id}}/confirm
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{}

### 60. Status / progress (COMPLETED hone tak)
GET {{baseUrl}}/imports/{{importPreview.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

### 61. Import history
GET {{baseUrl}}/imports
Authorization: Bearer {{login.response.body.accessToken}}
