// =====================================================================
// Calling CRM — Database Schema
// Yahi file database ka "source of truth" hai.
// Change karne ke baad:  npm run db:migrate -- --name <change_ka_naam>
// Docs: https://pris.ly/d/prisma-schema
//
// Time: saare timestamps "timestamptz" (timezone ke saath) — follow-up "4 PM" galat timezone me na jaaye.
//
// Naming convention:
//   - Prisma/TypeScript me camelCase  (createdAt, teamId)
//   - Database me snake_case          (created_at, team_id)  ← @map / @@map se
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Enums — fixed list of values (DB bhi galat value reject karega)
// ---------------------------------------------------------------------

/// Staff ke roles (design doc section 13). Decision: docs/decisions/0002-database-and-roles.md
enum StaffRole {
  SUPER_ADMIN
  MANAGER
  TEAM_LEADER
  ASSISTANT

  @@map("staff_role")
}

/// Assistant availability (design doc section 8.2) — assignment/follow-up engine isko dekhega
enum Availability {
  AVAILABLE
  ON_CALL
  BREAK
  OFFLINE

  @@map("availability")
}

/// Customer ki calling status
enum CustomerStatus {
  ACTIVE // call kar sakte hain
  DO_NOT_CALL // customer ne mana kiya — kabhi assign nahi hoga
  INVALID // galat/band number

  @@map("customer_status")
}

/// Customer priority — assignment engine pehle HIGH/URGENT uthayega (Phase 2)
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("priority")
}

// ---------------------------------------------------------------------
// Staff — CRM me LOGIN karne wale log (assistants, TL, managers, admins)
// Note: jinko call kiya jaata hai (customers) wo alag table hoga (Step 1.5)
// ---------------------------------------------------------------------
model Staff {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  phone        String?
  passwordHash String       @map("password_hash") // plain password KABHI save nahi hota
  role         StaffRole    @default(ASSISTANT)
  availability Availability @default(OFFLINE)
  isActive     Boolean      @default(true) @map("is_active") // delete ki jagah deactivate (history bachi rahe)

  teamId String? @map("team_id") @db.Uuid
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)

  ledTeams Team[] @relation("TeamLeader") // agar ye TEAM_LEADER hai to kaunsi teams lead karta hai

  customersCreated Customer[] @relation("CustomerCreatedBy")
  auditLogs        AuditLog[] @relation("AuditActor")

  assignments        Assignment[] @relation("AssignmentStaff")
  assignmentsCreated Assignment[] @relation("AssignmentCreatedBy")
  calls              Call[]

  categoryChanges   CustomerCategoryChange[]
  tagsAdded         CustomerTag[]
  campaignsCreated  Campaign[]               @relation("CampaignCreatedBy")
  campaignMembers   CampaignStaff[]
  campaignAdds      CampaignCustomer[]       @relation("CampaignCustomerAddedBy")
  followUpsOwned    FollowUp[]               @relation("FollowUpOwner")
  followUpsOriginal FollowUp[]               @relation("FollowUpOriginalOwner")
  notifications     Notification[]
  importBatches     ImportBatch[]
  callSessions      CallSession[]

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Heartbeat: aakhri API request kab aayi (har ~1 min update). Browser band = AVAILABLE hote hue bhi "away"
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([teamId])
  @@index([role, availability]) // "kaunse assistants AVAILABLE hain" query fast hogi
  @@map("staff")
}

// ---------------------------------------------------------------------
// Team — assistants ka group, ek Team Leader ke under
// ---------------------------------------------------------------------
model Team {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  leaderId String? @map("leader_id") @db.Uuid
  leader   Staff?  @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  members Staff[] @relation("TeamMembers")

  campaigns CampaignTeam[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([leaderId])
  @@map("teams")
}

// ---------------------------------------------------------------------
// Customer — jinko CALL kiya jaata hai (casino platform ke users, ~20k+)
// Design doc me inhe "users" kaha gaya hai; code me "customers" taaki staff se confusion na ho.
// ---------------------------------------------------------------------
model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  externalId     String?        @unique @map("external_id") // casino platform ki user ID (import/match ke liye)
  name           String
  phone          String         @unique // E.164 format me normalize: +919876543210 → duplicate check pakka
  alternatePhone String?        @map("alternate_phone")
  email          String?
  status         CustomerStatus @default(ACTIVE)
  priority       Priority       @default(NORMAL)
  notes          String? // general notes (call ke notes alag table me aayenge — Phase 2)

  // Calling summary (har call save pe update) — list/profile/assignment ke liye fast
  lastCalledAt DateTime? @map("last_called_at") @db.Timestamptz(3)
  callCount    Int       @default(0) @map("call_count")

  // Rating & category (Phase 4) — latest rating se category engine decide karta hai
  interestRating    Int?      @map("interest_rating") // latest 0–10
  categoryId        String?   @map("category_id") @db.Uuid
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryUpdatedAt DateTime? @map("category_updated_at") @db.Timestamptz(3)

  categoryChanges CustomerCategoryChange[]
  tags            CustomerTag[]
  campaigns       CampaignCustomer[]

  assignments  Assignment[]
  calls        Call[]
  followUps    FollowUp[]
  callSessions CallSession[]

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   Staff?  @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, priority]) // "call karne layak, high priority pehle" query fast
  @@index([name])
  @@index([status, lastCalledAt, priority, createdAt]) // assignment engine ki query
  @@index([categoryId])
  @@map("customers")
}

// ---------------------------------------------------------------------
// AuditLog — "kisne, kya, kab, kis cheez pe" (design doc section 19)
// APPEND-ONLY: sirf naye rows bante hain; update/delete ki koi API nahi.
// ---------------------------------------------------------------------
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid // null = system ya anonymous (e.g. failed login)
  actor   Staff?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String // e.g. "staff.created", "customer.updated", "auth.login_failed"
  entityType String  @map("entity_type") // "staff" | "team" | "customer" | ...
  entityId   String? @map("entity_id") // kis record pe (uuid ya koi id)
  changes    Json? // { field: { from, to } } — sirf jo badla
  metadata   Json? // extra context (e.g. login attempt ka email)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt]) // "is customer ki history"
  @@index([actorId, createdAt]) // "Amit ne kya kya kiya"
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================================
// CALL FORM CONFIGURATION (Phase 2.1)
// Hard-coded nahi — Manager Settings screen se badal sakta hai.
// Default values migration me daali gayi hain (har environment me same).
// =====================================================================

/// Call ka nateeja: Connected, No Answer, Busy... (design doc section 6)
model CallOutcome {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // e.g. "NO_ANSWER" — kabhi nahi badalta (reports isi se)
  label       String // screen pe dikhne wala naam — badal sakte hain
  isConnected Boolean @default(false) @map("is_connected") // customer se baat hui? (connected = notes/rating maange ja sakte hain)
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order") // dropdown me kis order me

  calls Call[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("call_outcomes")
}

/// Call ke baad kya karna hai: No Further Action, Follow-up, Call Again...
model NextAction {
  id               String  @id @default(uuid()) @db.Uuid
  code             String  @unique
  label            String
  requiresFollowUp Boolean @default(false) @map("requires_follow_up") // true → follow-up date/time mandatory
  isActive         Boolean @default(true) @map("is_active")
  sortOrder        Int     @default(0) @map("sort_order")

  calls Call[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("next_actions")
}

/// Key-value settings (JSON). e.g. key "call_form.required_fields"
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

// =====================================================================
// CALLING WORKFLOW (Phase 2)
// =====================================================================

/// Assignment ki zindagi:  ASSIGNED (manager ne queue me daala) → IN_PROGRESS (assistant ki current screen)
///                          → COMPLETED (call save) | CANCELLED (manager ne hataya / reassign kiya)
enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("assignment_status")
}

enum AssignmentSource {
  AUTO // assistant ne "Start Calling" se khud liya (pull)
  MANUAL // manager / team leader ne diya
  FOLLOW_UP // due follow-up (Phase 3) — engine ne sabse pehle diya

  @@map("assignment_source")
}

/// Kaunsa customer kis staff ke paas hai. Ek customer = ek waqt me sirf EK open assignment.
model Assignment {
  id     String           @id @default(uuid()) @db.Uuid
  status AssignmentStatus
  source AssignmentSource

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  staffId    String   @map("staff_id") @db.Uuid
  staff      Staff    @relation("AssignmentStaff", fields: [staffId], references: [id])

  createdById String? @map("created_by_id") @db.Uuid // MANUAL ho to kisne diya
  createdBy   Staff?  @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// DUPLICATE ROKNE KI TRICK (database-level guarantee, race condition me bhi):
  ///   openCustomerId    = customerId jab tak ASSIGNED/IN_PROGRESS, warna NULL
  ///   inProgressStaffId = staffId    jab tak IN_PROGRESS,          warna NULL
  /// @unique + NULL allowed → ek customer ka ek hi open assignment, ek staff ka ek hi current customer.
  openCustomerId    String? @unique @map("open_customer_id") @db.Uuid
  inProgressStaffId String? @unique @map("in_progress_staff_id") @db.Uuid

  campaignId String?   @map("campaign_id") @db.Uuid // kis campaign ke liye (call isi campaign me count hogi)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  followUpId String?   @map("follow_up_id") @db.Uuid // source = FOLLOW_UP ho to kaunsa follow-up
  followUp   FollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)

  calls        Call[]
  callSessions CallSession[]

  startedAt   DateTime? @map("started_at") @db.Timestamptz(3) // IN_PROGRESS kab hua
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([staffId, status])
  @@index([customerId, createdAt])
  @@map("assignments")
}

/// Ek call ka record (call form). Customer ki permanent history.
model Call {
  id String @id @default(uuid()) @db.Uuid

  customerId   String      @map("customer_id") @db.Uuid
  customer     Customer    @relation(fields: [customerId], references: [id])
  staffId      String      @map("staff_id") @db.Uuid
  staff        Staff       @relation(fields: [staffId], references: [id])
  assignmentId String?     @map("assignment_id") @db.Uuid
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  outcomeId    String      @map("outcome_id") @db.Uuid
  outcome      CallOutcome @relation(fields: [outcomeId], references: [id])
  nextActionId String      @map("next_action_id") @db.Uuid
  nextAction   NextAction  @relation(fields: [nextActionId], references: [id])

  userResponse   String?   @map("user_response") // customer ne kya kaha (structured/short)
  notes          String? // poori baat-cheet ke notes
  interestRating Int?      @map("interest_rating") // 0–10 (Phase 4: category isi se)
  followUpAt     DateTime? @map("follow_up_at") @db.Timestamptz(3) // Phase 3: follow-up record isi se banega

  campaignId   String?   @map("campaign_id") @db.Uuid
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  customFields Json?     @map("custom_fields") // campaign ke extra fields: { key: value } (validated)

  createdFollowUp    FollowUp?                @relation("FollowUpSourceCall")
  categoryChanges    CustomerCategoryChange[]
  completedFollowUps FollowUp[]               @relation("FollowUpCompletedBy")
  telephony          CallSession[] // provider ki asli call(s): duration, recording (Phase 7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId, createdAt]) // customer history
  @@index([staffId, createdAt]) // assistant ki calls (reports)
  @@index([campaignId, createdAt]) // campaign reports
  @@index([createdAt])
  @@map("calls")
}

// =====================================================================
// FOLLOW-UPS + NOTIFICATIONS (Phase 3) — design doc section 8 + 18
// =====================================================================

/// PENDING (scheduled / due / overdue — dueAt se decide) → IN_PROGRESS (assistant call kar raha)
/// → COMPLETED (customer ko call ho gaya) | CANCELLED (manager ne hataya)
enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("follow_up_status")
}

/// "Call me at 4 PM" — alag record, comment me dabba nahi (reminder, escalation, report ke liye)
model FollowUp {
  id     String         @id @default(uuid()) @db.Uuid
  status FollowUpStatus @default(PENDING)
  dueAt  DateTime       @map("due_at") @db.Timestamptz(3)

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  sourceCallId String @unique @map("source_call_id") @db.Uuid // kis call me promise hua
  sourceCall   Call   @relation("FollowUpSourceCall", fields: [sourceCallId], references: [id])

  ownerId         String @map("owner_id") @db.Uuid // abhi kiski zimmedari (escalation pe badalta hai)
  owner           Staff  @relation("FollowUpOwner", fields: [ownerId], references: [id])
  originalOwnerId String @map("original_owner_id") @db.Uuid // jisne promise kiya tha
  originalOwner   Staff  @relation("FollowUpOriginalOwner", fields: [originalOwnerId], references: [id])

  /// Ek customer ka ek hi open follow-up (assignments wali unique-nullable trick)
  openCustomerId String? @unique @map("open_customer_id") @db.Uuid

  // Scheduler ke "ho gaya" markers — dobara notification na jaaye (idempotent)
  reminderSentAt    DateTime? @map("reminder_sent_at") @db.Timestamptz(3)
  dueNotifiedAt     DateTime? @map("due_notified_at") @db.Timestamptz(3)
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz(3)
  escalatedAt       DateTime? @map("escalated_at") @db.Timestamptz(3)
  escalationCount   Int       @default(0) @map("escalation_count")

  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  completedByCallId String?   @map("completed_by_call_id") @db.Uuid
  completedByCall   Call?     @relation("FollowUpCompletedBy", fields: [completedByCallId], references: [id], onDelete: SetNull)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(3)

  assignments Assignment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, dueAt]) // scheduler: "kaun se due / overdue"
  @@index([ownerId, status, dueAt]) // "meri due follow-ups" (engine + list)
  @@map("follow_ups")
}

enum NotificationType {
  FOLLOW_UP_REMINDER // owner: 1 min me due
  FOLLOW_UP_DUE // owner: abhi due
  FOLLOW_UP_ESCALATED_TO_YOU // naya owner: aapko diya gaya
  FOLLOW_UP_ESCALATED_AWAY // purana owner: aap unavailable the, kisi aur ko gaya
  FOLLOW_UP_OVERDUE // team leader / manager: grace ke baad bhi pending
  FOLLOW_UP_REASSIGNED // naya owner: manager ne diya
  IMPORT_COMPLETED // importer: bulk import khatam (design doc 18: "import completion")
  IMPORT_FAILED // importer: import beech me fail

  @@map("notification_type")
}

/// In-app notification (header ka 🔔). Email/SMS baad me isi table se.
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  recipient   Staff            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String?
  link        String? // click → kaunsa page
  data        Json?
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

// =====================================================================
// RATING, CATEGORIES & TAGS (Phase 4) — design doc section 10
// "Category thresholds are data/configuration, not hard-coded"
// =====================================================================

/// Interest category: rating range → category (e.g. 8–9 → High Interest). Manager Settings se badalta hai.
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique // "HIGH_INTEREST" — permanent (reports)
  label     String
  minRating Int       @map("min_rating") // inclusive
  maxRating Int       @map("max_rating") // inclusive
  color     String    @default("gray") // UI badge tone
  priority  Priority? // is category me aate hi customer ki priority (null = mat chhedo)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")

  customers   Customer[]
  changesFrom CustomerCategoryChange[] @relation("CategoryChangeFrom")
  changesTo   CustomerCategoryChange[] @relation("CategoryChangeTo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("categories")
}

/// Category badalne ki history (design doc section 12: "Category Changes")
model CustomerCategoryChange {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromId      String?   @map("from_category_id") @db.Uuid
  from        Category? @relation("CategoryChangeFrom", fields: [fromId], references: [id], onDelete: SetNull)
  toId        String?   @map("to_category_id") @db.Uuid
  to          Category? @relation("CategoryChangeTo", fields: [toId], references: [id], onDelete: SetNull)
  rating      Int? // kis rating pe badla
  reason      String // "call_rating" | "threshold_change"
  callId      String?   @map("call_id") @db.Uuid
  call        Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  changedById String?   @map("changed_by_id") @db.Uuid
  changedBy   Staff?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@map("customer_category_changes")
}

/// Free labels: "Callback Requested", "Big Spender", "Language: Tamil"...
model Tag {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  color     String        @default("gray")
  isActive  Boolean       @default(true) @map("is_active")
  customers CustomerTag[]
  imports   ImportBatch[]
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tags")
}

/// Customer ↔ Tag (many-to-many "join table")
model CustomerTag {
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String   @map("tag_id") @db.Uuid
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedById  String?  @map("added_by_id") @db.Uuid
  addedBy    Staff?   @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([customerId, tagId]) // composite primary key: ek tag ek customer pe ek hi baar
  @@index([tagId])
  @@map("customer_tags")
}

// =====================================================================
// CAMPAIGNS (Phase 5) — design doc section 11
// "Each campaign can have its own user population, assistants/teams, priority, scripts, fields and reporting"
// =====================================================================

/// DRAFT (setup) → ACTIVE (calls chal rahe) ↔ PAUSED → COMPLETED (band)
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED

  @@map("campaign_status")
}

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique
  description String?
  status      CampaignStatus @default(DRAFT)
  priority    Int            @default(0) // bada number = engine pehle is campaign ke customers deta hai
  script      String? // call script — assistant ko calling screen pe dikhta hai
  startsAt    DateTime?      @map("starts_at") @db.Timestamptz(3) // null = abhi se
  endsAt      DateTime?      @map("ends_at") @db.Timestamptz(3) // null = koi end nahi

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   Staff?  @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  customers   CampaignCustomer[]
  staff       CampaignStaff[]
  teams       CampaignTeam[]
  fields      CampaignField[]
  assignments Assignment[]
  calls       Call[]
  imports     ImportBatch[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, priority])
  @@map("campaigns")
}

/// Campaign ki "user population". Ek customer kai campaigns me ho sakta hai.
model CampaignCustomer {
  campaignId String   @map("campaign_id") @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Is campaign ke andar progress (customer ki overall calls se alag)
  callCount     Int       @default(0) @map("call_count")
  lastCalledAt  DateTime? @map("last_called_at") @db.Timestamptz(3)
  lastOutcomeId String?   @map("last_outcome_id") @db.Uuid

  addedById String?  @map("added_by_id") @db.Uuid
  addedBy   Staff?   @relation("CampaignCustomerAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  @@id([campaignId, customerId])
  @@index([campaignId, callCount, addedAt]) // engine: "is campaign me agla uncalled customer"
  @@index([customerId])
  @@map("campaign_customers")
}

/// Campaign kaun call kar sakta hai — seedhe staff...
model CampaignStaff {
  campaignId String   @map("campaign_id") @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  staffId    String   @map("staff_id") @db.Uuid
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([campaignId, staffId])
  @@index([staffId])
  @@map("campaign_staff")
}

/// ...ya poori team. (Na staff na team = sab call kar sakte hain)
model CampaignTeam {
  campaignId String   @map("campaign_id") @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  teamId     String   @map("team_id") @db.Uuid
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([campaignId, teamId])
  @@index([teamId])
  @@map("campaign_teams")
}

enum CampaignFieldType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN

  @@map("campaign_field_type")
}

/// Campaign-specific call form field (design doc section 6 "Custom Fields")
model CampaignField {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  key        String // "deposit_interest" — call.customFields me isi naam se save (permanent)
  label      String
  type       CampaignFieldType
  options    String[]          @default([]) // SELECT ke options
  required   Boolean           @default(false)
  isActive   Boolean           @default(true) @map("is_active")
  sortOrder  Int               @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([campaignId, key])
  @@map("campaign_fields")
}

// =====================================================================
// BULK IMPORT (Phase 6) — design doc section 16
// Upload → validation → duplicate check → PREVIEW → confirm → background import → result
// =====================================================================

enum ImportStatus {
  PREVIEW // file parse + validate ho gayi, manager confirm karega
  QUEUED // confirm ho gaya, background job ka wait
  PROCESSING // background job customers bana raha hai
  COMPLETED
  FAILED // beech me error — "Retry" se wahin se aage
  CANCELLED // preview ke baad cancel

  @@map("import_status")
}

enum ImportRowStatus {
  VALID // import hoga
  INVALID // galat data (errors me wajah)
  DUPLICATE // file me pehle aa chuka / DB me pehle se hai
  IMPORTED // customer ban gaya
  SKIPPED // preview ke baad kisi ne same phone/ID se customer bana diya

  @@map("import_row_status")
}

/// Ek upload = ek batch (import history: kisne, kab, kitne, kitne fail)
model ImportBatch {
  id       String       @id @default(uuid()) @db.Uuid
  fileName String       @map("file_name")
  status   ImportStatus @default(PREVIEW)

  totalRows     Int @map("total_rows")
  validRows     Int @map("valid_rows")
  invalidRows   Int @map("invalid_rows")
  duplicateRows Int @map("duplicate_rows")
  importedRows  Int @default(0) @map("imported_rows")
  skippedRows   Int @default(0) @map("skipped_rows")

  // Confirm pe optional: naye customers seedhe campaign me / tag ke saath
  campaignId String?   @map("campaign_id") @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  tagId      String?   @map("tag_id") @db.Uuid
  tag        Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)

  error          String? // FAILED ki wajah
  ignoredColumns String[] @default([]) @map("ignored_columns") // file ke extra columns jo import nahi hue (e.g. "City")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   Staff?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  rows ImportRow[]

  @@index([createdAt])
  @@index([status])
  @@map("import_batches")
}

/// File ki har line — preview, error report aur "kaunsa customer bana" ke liye
model ImportRow {
  id        String          @id @default(uuid()) @db.Uuid
  batchId   String          @map("batch_id") @db.Uuid
  batch     ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int             @map("row_number") // file ki line (header = 1, data 2 se)
  raw       Json // file me jaisa likha tha (error CSV me wapas)
  data      Json? // normalized values (sirf VALID me) — inhi se customer banta hai
  status    ImportRowStatus
  errors    String[]

  customerId String? @map("customer_id") @db.Uuid // IMPORTED: kaunsa customer bana / DUPLICATE: kis se match hua

  @@unique([batchId, rowNumber])
  @@index([batchId, status, rowNumber])
  @@map("import_rows")
}

// =====================================================================
// CALLING PROVIDER (Phase 7) — design doc section 17
// CRM = control layer; asli call + recording provider (telecalling.ai) karta hai.
// Provider kaunsa hai wo env se (TELEPHONY_PROVIDER) — code sirf TelephonyProvider interface jaanta hai.
// =====================================================================

enum CallSessionStatus {
  DIALED // manual provider: phone app ko number de diya (aage ka pata nahi)
  INITIATED // provider ko "call lagao" bola
  RINGING
  ANSWERED // customer ne uthaya — baat chal rahi hai
  COMPLETED // baat hui, call khatam
  NO_ANSWER
  BUSY
  FAILED
  CANCELED

  @@map("call_session_status")
}

/// Ek dial attempt (assistant ne "Call" dabaya). Ek CRM call (form) ke kai attempts ho sakte hain.
model CallSession {
  id             String  @id @default(uuid()) @db.Uuid
  provider       String // "manual" | "mock" | "telecalling" ...
  providerCallId String? @map("provider_call_id") // provider ki call ID (webhook isi se match)

  customerId   String      @map("customer_id") @db.Uuid
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId      String      @map("staff_id") @db.Uuid
  staff        Staff       @relation(fields: [staffId], references: [id])
  assignmentId String?     @map("assignment_id") @db.Uuid
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  callId       String?     @map("call_id") @db.Uuid // Save & Next ke baad CRM call se link
  call         Call?       @relation(fields: [callId], references: [id], onDelete: SetNull)

  toNumber     String            @map("to_number")
  status       CallSessionStatus
  answeredAt   DateTime?         @map("answered_at") @db.Timestamptz(3)
  endedAt      DateTime?         @map("ended_at") @db.Timestamptz(3)
  durationSec  Int?              @map("duration_sec") // baat kitni der hui
  recordingUrl String?           @map("recording_url") // provider ka recording link (sirf https)
  failReason   String?           @map("fail_reason")

  events CallEvent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerCallId])
  @@index([assignmentId, createdAt])
  @@index([customerId, createdAt])
  @@index([staffId, createdAt])
  @@map("call_sessions")
}

/// Provider se aaya har webhook event (debug + audit). eventId se duplicate ignore.
model CallEvent {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  session   CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  provider  String
  eventId   String?     @map("event_id") // provider ki event ID (retry pe same aati hai)
  type      String // ringing | answered | completed | no_answer | busy | failed | canceled
  payload   Json // jaisa aaya waisa (sensitive headers nahi)
  applied   Boolean // false = purana / out-of-order event, status nahi badla

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([sessionId, occurredAt])
  @@map("call_events")
}
