// =====================================================================
// Calling CRM — Database Schema
// Yahi file database ka "source of truth" hai.
// Change karne ke baad:  npm run db:migrate -- --name <change_ka_naam>
// Docs: https://pris.ly/d/prisma-schema
//
// Time: saare timestamps "timestamptz" (timezone ke saath) — follow-up "4 PM" galat timezone me na jaaye.
//
// Naming convention:
//   - Prisma/TypeScript me camelCase  (createdAt, teamId)
//   - Database me snake_case          (created_at, team_id)  ← @map / @@map se
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Enums — fixed list of values (DB bhi galat value reject karega)
// ---------------------------------------------------------------------

/// Staff ke roles (design doc section 13). Decision: docs/decisions/0002-database-and-roles.md
enum StaffRole {
  SUPER_ADMIN
  MANAGER
  TEAM_LEADER
  ASSISTANT

  @@map("staff_role")
}

/// Assistant availability (design doc section 8.2) — assignment/follow-up engine isko dekhega
enum Availability {
  AVAILABLE
  ON_CALL
  BREAK
  OFFLINE

  @@map("availability")
}

/// Customer ki calling status
enum CustomerStatus {
  ACTIVE // call kar sakte hain
  DO_NOT_CALL // customer ne mana kiya — kabhi assign nahi hoga
  INVALID // galat/band number

  @@map("customer_status")
}

/// Customer priority — assignment engine pehle HIGH/URGENT uthayega (Phase 2)
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("priority")
}

// ---------------------------------------------------------------------
// Staff — CRM me LOGIN karne wale log (assistants, TL, managers, admins)
// Note: jinko call kiya jaata hai (customers) wo alag table hoga (Step 1.5)
// ---------------------------------------------------------------------
model Staff {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  phone        String?
  passwordHash String       @map("password_hash") // plain password KABHI save nahi hota
  role         StaffRole    @default(ASSISTANT)
  availability Availability @default(OFFLINE)
  isActive     Boolean      @default(true) @map("is_active") // delete ki jagah deactivate (history bachi rahe)

  teamId String? @map("team_id") @db.Uuid
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)

  ledTeams Team[] @relation("TeamLeader") // agar ye TEAM_LEADER hai to kaunsi teams lead karta hai

  customersCreated Customer[] @relation("CustomerCreatedBy")
  auditLogs        AuditLog[] @relation("AuditActor")

  assignments        Assignment[] @relation("AssignmentStaff")
  assignmentsCreated Assignment[] @relation("AssignmentCreatedBy")
  calls              Call[]

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([teamId])
  @@index([role, availability]) // "kaunse assistants AVAILABLE hain" query fast hogi
  @@map("staff")
}

// ---------------------------------------------------------------------
// Team — assistants ka group, ek Team Leader ke under
// ---------------------------------------------------------------------
model Team {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  leaderId String? @map("leader_id") @db.Uuid
  leader   Staff?  @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  members Staff[] @relation("TeamMembers")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([leaderId])
  @@map("teams")
}

// ---------------------------------------------------------------------
// Customer — jinko CALL kiya jaata hai (casino platform ke users, ~20k+)
// Design doc me inhe "users" kaha gaya hai; code me "customers" taaki staff se confusion na ho.
// ---------------------------------------------------------------------
model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  externalId     String?        @unique @map("external_id") // casino platform ki user ID (import/match ke liye)
  name           String
  phone          String         @unique // E.164 format me normalize: +919876543210 → duplicate check pakka
  alternatePhone String?        @map("alternate_phone")
  email          String?
  status         CustomerStatus @default(ACTIVE)
  priority       Priority       @default(NORMAL)
  notes          String? // general notes (call ke notes alag table me aayenge — Phase 2)

  // Calling summary (har call save pe update) — list/profile/assignment ke liye fast
  lastCalledAt DateTime? @map("last_called_at") @db.Timestamptz(3)
  callCount    Int       @default(0) @map("call_count")

  assignments Assignment[]
  calls       Call[]

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   Staff?  @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, priority]) // "call karne layak, high priority pehle" query fast
  @@index([name])
  @@index([status, lastCalledAt, priority, createdAt]) // assignment engine ki query
  @@map("customers")
}

// ---------------------------------------------------------------------
// AuditLog — "kisne, kya, kab, kis cheez pe" (design doc section 19)
// APPEND-ONLY: sirf naye rows bante hain; update/delete ki koi API nahi.
// ---------------------------------------------------------------------
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid // null = system ya anonymous (e.g. failed login)
  actor   Staff?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String // e.g. "staff.created", "customer.updated", "auth.login_failed"
  entityType String  @map("entity_type") // "staff" | "team" | "customer" | ...
  entityId   String? @map("entity_id") // kis record pe (uuid ya koi id)
  changes    Json? // { field: { from, to } } — sirf jo badla
  metadata   Json? // extra context (e.g. login attempt ka email)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt]) // "is customer ki history"
  @@index([actorId, createdAt]) // "Amit ne kya kya kiya"
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================================
// CALL FORM CONFIGURATION (Phase 2.1)
// Hard-coded nahi — Manager Settings screen se badal sakta hai.
// Default values migration me daali gayi hain (har environment me same).
// =====================================================================

/// Call ka nateeja: Connected, No Answer, Busy... (design doc section 6)
model CallOutcome {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // e.g. "NO_ANSWER" — kabhi nahi badalta (reports isi se)
  label       String // screen pe dikhne wala naam — badal sakte hain
  isConnected Boolean @default(false) @map("is_connected") // customer se baat hui? (connected = notes/rating maange ja sakte hain)
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order") // dropdown me kis order me

  calls Call[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("call_outcomes")
}

/// Call ke baad kya karna hai: No Further Action, Follow-up, Call Again...
model NextAction {
  id               String  @id @default(uuid()) @db.Uuid
  code             String  @unique
  label            String
  requiresFollowUp Boolean @default(false) @map("requires_follow_up") // true → follow-up date/time mandatory
  isActive         Boolean @default(true) @map("is_active")
  sortOrder        Int     @default(0) @map("sort_order")

  calls Call[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("next_actions")
}

/// Key-value settings (JSON). e.g. key "call_form.required_fields"
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

// =====================================================================
// CALLING WORKFLOW (Phase 2)
// =====================================================================

/// Assignment ki zindagi:  ASSIGNED (manager ne queue me daala) → IN_PROGRESS (assistant ki current screen)
///                          → COMPLETED (call save) | CANCELLED (manager ne hataya / reassign kiya)
enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("assignment_status")
}

enum AssignmentSource {
  AUTO // assistant ne "Start Calling" se khud liya (pull)
  MANUAL // manager / team leader ne diya

  @@map("assignment_source")
}

/// Kaunsa customer kis staff ke paas hai. Ek customer = ek waqt me sirf EK open assignment.
model Assignment {
  id     String           @id @default(uuid()) @db.Uuid
  status AssignmentStatus
  source AssignmentSource

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  staffId    String   @map("staff_id") @db.Uuid
  staff      Staff    @relation("AssignmentStaff", fields: [staffId], references: [id])

  createdById String? @map("created_by_id") @db.Uuid // MANUAL ho to kisne diya
  createdBy   Staff?  @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// DUPLICATE ROKNE KI TRICK (database-level guarantee, race condition me bhi):
  ///   openCustomerId    = customerId jab tak ASSIGNED/IN_PROGRESS, warna NULL
  ///   inProgressStaffId = staffId    jab tak IN_PROGRESS,          warna NULL
  /// @unique + NULL allowed → ek customer ka ek hi open assignment, ek staff ka ek hi current customer.
  openCustomerId    String? @unique @map("open_customer_id") @db.Uuid
  inProgressStaffId String? @unique @map("in_progress_staff_id") @db.Uuid

  calls Call[]

  startedAt   DateTime? @map("started_at") @db.Timestamptz(3) // IN_PROGRESS kab hua
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([staffId, status])
  @@index([customerId, createdAt])
  @@map("assignments")
}

/// Ek call ka record (call form). Customer ki permanent history.
model Call {
  id String @id @default(uuid()) @db.Uuid

  customerId   String      @map("customer_id") @db.Uuid
  customer     Customer    @relation(fields: [customerId], references: [id])
  staffId      String      @map("staff_id") @db.Uuid
  staff        Staff       @relation(fields: [staffId], references: [id])
  assignmentId String?     @map("assignment_id") @db.Uuid
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  outcomeId    String      @map("outcome_id") @db.Uuid
  outcome      CallOutcome @relation(fields: [outcomeId], references: [id])
  nextActionId String      @map("next_action_id") @db.Uuid
  nextAction   NextAction  @relation(fields: [nextActionId], references: [id])

  userResponse   String?   @map("user_response") // customer ne kya kaha (structured/short)
  notes          String? // poori baat-cheet ke notes
  interestRating Int?      @map("interest_rating") // 0–10 (Phase 4: category isi se)
  followUpAt     DateTime? @map("follow_up_at") @db.Timestamptz(3) // Phase 3: follow-up record isi se banega

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId, createdAt]) // customer history
  @@index([staffId, createdAt]) // assistant ki calls (reports)
  @@index([createdAt])
  @@map("calls")
}
