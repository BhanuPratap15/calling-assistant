# =====================================================================
# Nginx — HTTPS + reverse proxy. ${SERVER_NAME} container start pe .env.production se bharta hai.
#   /api/*  → api:4000 (NestJS)      baaki sab → web:3000 (Next.js)
# =====================================================================

# Rate limits (har IP): login 20/min, baaki API 50/sec (office NAT pe sab ek IP — generous)
limit_req_zone $binary_remote_addr zone=login:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=50r/s;
limit_req_status 429;

upstream crm_api { server api:4000; keepalive 16; }
upstream crm_web { server web:3000; keepalive 16; }

# HTTP → HTTPS (Let's Encrypt challenge ko chhod ke)
server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 12m; # import file max 10 MB
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/csv;

    # Security headers (browser ko) — API ke apne helmet headers neeche hide, duplicate na hon
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /api/auth/login {
        limit_req zone=login burst=20 nodelay;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_pass http://crm_api;
    }

    location /api/ {
        limit_req zone=api burst=200 nodelay;
        proxy_read_timeout 120s; # 20k rows import preview
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_pass http://crm_api;
    }

    location / {
        proxy_pass http://crm_web;
    }
}
