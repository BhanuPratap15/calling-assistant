# White-label client domain: ${TENANT_HOST}
# Auto-generated by ops/platform/sync-domains.sh — haath se edit mat karo (agli sync overwrite karegi).
server {
    listen 443 ssl;
    http2 on;
    server_name ${TENANT_HOST};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${TENANT_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TENANT_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/snippets/crm-locations.conf;
}
