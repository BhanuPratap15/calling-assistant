{
  "name": "calling-assistant",
  "private": true,
  "description": "Calling CRM & Lead Management System (monorepo)",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w @crm/api",
    "dev:web": "npm run dev -w @crm/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test -w @crm/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "db:migrate": "npm run db:migrate -w @crm/api --",
    "db:studio": "npm run db:studio -w @crm/api",
    "db:generate": "npm run db:generate -w @crm/api",
    "db:seed": "npm run db:seed -w @crm/api"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
